<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- annotations, not disable: the Orleans state and grain types below are written with
         the '?' annotations that library's own samples use, and under 'disable' each one is
         a CS8632. Annotations are read and nullable warnings stay off, so no lab changes. -->
    <Nullable>annotations</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>UnitTestAssembledVerbOnPuppeteer</AssemblyName>
    <RootNamespace>UnitTestAssembledVerbOnPuppeteer</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The engine. It defaults to the sibling clone every lab in this repository uses,
         so a reviewer who cloned the two repositories side by side sets nothing. Point
         PuppeteerEngine elsewhere if the checkout lives somewhere else:

             $env:PuppeteerEngine = "C:\path\to\Puppeteer"
             dotnet test -p:PuppeteerEngine=C:\path\to\Puppeteer

         The paper's counts were taken at commit 3160e39. -->
    <PuppeteerEngine Condition="'$(PuppeteerEngine)' == ''">$(MSBuildThisFileDirectory)..\..\..\puppeteer</PuppeteerEngine>
    <CorpusBinDir>$(MSBuildThisFileDirectory)corpus-bin</CorpusBinDir>
    <!-- fetch-corpus.ps1 clones the two corpus repositories into corpus-src/ beside this
         file by default, and the SDK's default glob would then compile both repositories'
         entire source as part of this project - hundreds of CS0246 from files that are not
         this lab's. .gitignore lists corpus-src/, which is why it never appeared in a
         commit, but MSBuild does not read .gitignore. Excluded from every default item
         glob, not only Compile, so the same cannot happen through another item type.
         Check it with: dotnet msbuild paper0A-assembled-verb.csproj -getItem:Compile -->
    <DefaultItemExcludes>$(DefaultItemExcludes);corpus-src\**;corpus-bin\**</DefaultItemExcludes>
    <!-- Two analyzer opinions this suite declines, each for a stated reason.
         MSTEST0037 asks for the typed assertion in place of Assert.IsTrue; these labs keep
         Assert.IsTrue because its second argument carries the sentence that says what the
         assertion means, and that sentence is what a reviewer reads when one fails.
         VSTHRD200 asks for an "Async" suffix on methods returning an awaitable; the methods
         it names are Orleans grain-interface members whose names are the vocabulary of the
         arrangement being measured, and renaming them would rename the measurement.
         This silences this project's own warnings, not the build's: the engine is consumed
         as a ProjectReference and compiles with a handful of its own, which nothing here
         can suppress. Expect those to remain. -->
    <NoWarn>$(NoWarn);MSTEST0037;VSTHRD200</NoWarn>
  </PropertyGroup>

  <!-- Both externals this suite needs are checked here rather than left to fail as a
       missing path or as several hundred CS0246s. -->
  <Target Name="RequireEngineAndCorpus" BeforeTargets="CollectPackageReferences;ResolveProjectReferences">
    <Error Condition="!Exists('$(PuppeteerEngine)\Puppeteer\Puppeteer.csproj')"
           Text="The engine was not found at $(PuppeteerEngine). Clone github.com/alvaroNCubo/puppeteer as a sibling of this repository, at commit 3160e39, or set -p:PuppeteerEngine=&lt;path&gt;. See labs/paper0A-README.md." />
    <Error Condition="!Exists('$(CorpusBinDir)\Ordering.Domain.dll') Or !Exists('$(CorpusBinDir)\CompanyName.MyMeetings.Modules.Payments.Domain.dll') Or !Exists('$(CorpusBinDir)\CompanyName.MyMeetings.BuildingBlocks.Domain.dll')"
           Text="corpus-bin is missing at least one of the three corpus assemblies. Run .\fetch-corpus.ps1 once: it clones both corpus repositories at their pinned commits and builds them. Nothing of either repository is redistributed here. See labs/paper0A-README.md." />
  </Target>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.1" />
    <PackageReference Include="Microsoft.Azure.DurableTask.Emulator" Version="2.6.0" />
    <PackageReference Include="Microsoft.Orleans.TestingHost" Version="10.2.2" />
    <PackageReference Include="Microsoft.Orleans.EventSourcing" Version="10.2.2" />
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.2.2" />
    <PackageReference Include="MediatR" Version="13.0.0" />
    <PackageReference Include="MediatR.Contracts" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine, at the path resolved above: the sibling clone by default. -->
    <ProjectReference Include="$(PuppeteerEngine)\Puppeteer\Puppeteer.csproj" />
    <!-- Referenced so it is always built and lands beside the tests. Referencing it grants
         no access to what it declares internal - that is the point of the boundary lab, and
         this project is the host that cannot name it. -->
    <ProjectReference Include="RepertoireBoundaryFixture\RepertoireBoundaryFixture.csproj" />
  </ItemGroup>

  <!-- Two domain assemblies, authored by different parties, consumed as prebuilt binaries.
       Neither is redistributed here: run fetch-corpus.ps1 once to clone both repositories at
       the pinned commits and build these files into corpus-bin/. -->
  <ItemGroup>
    <Reference Include="Ordering.Domain">
      <HintPath>corpus-bin\Ordering.Domain.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="CompanyName.MyMeetings.Modules.Payments.Domain">
      <HintPath>corpus-bin\CompanyName.MyMeetings.Modules.Payments.Domain.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="CompanyName.MyMeetings.BuildingBlocks.Domain">
      <HintPath>corpus-bin\CompanyName.MyMeetings.BuildingBlocks.Domain.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- The fixture is a nested project consumed via ProjectReference; keep its sources and
       generated files out of this project's default compile glob. -->
  <ItemGroup>
    <Compile Remove="RepertoireBoundaryFixture\**\*.cs" />
    <None Remove="RepertoireBoundaryFixture\**" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
