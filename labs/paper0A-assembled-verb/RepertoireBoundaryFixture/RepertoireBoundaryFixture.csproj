<Project Sdk="Microsoft.NET.Sdk">

  <!-- A repertoire in its own assembly, so that `internal` means what it means: the host
       language cannot reach in. Nothing here is public. The point of the fixture is the
       visibility, not the behaviour. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
