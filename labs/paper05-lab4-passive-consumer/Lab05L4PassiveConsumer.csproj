<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- AssemblyName must match the InternalsVisibleTo grant in the runtime
         (Puppeteer/InternalsVisibleTo.cs) — the apply step uses the internal
         structured-write seam (see README "Guide compliance"). -->
    <AssemblyName>Lab05L4PassiveConsumer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sibling clone of https://github.com/alvaroNCubo/puppeteer at the cited
         provenance commit (see README) — convention shared with lab01-04 and
         paper05-lab1. Choreography supplies PerformanceV2 + LocalMaterializeSource. -->
    <ProjectReference Include="..\..\..\puppeteer\Puppeteer\Puppeteer.csproj" />
    <ProjectReference Include="..\..\..\puppeteer\Choreography\Choreography.csproj" />
  </ItemGroup>

</Project>
