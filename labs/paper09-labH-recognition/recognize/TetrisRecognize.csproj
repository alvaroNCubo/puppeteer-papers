<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tetris.Recognizing</RootNamespace>
    <AssemblyName>TetrisRecognize</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The domain is a PARAMETER, exactly as it is for every other host: the
      recognizer needs the assembly only so the actor it opens over a journal can
      rehydrate. Nothing in the domain is edited or referenced by name beyond the
      public anchor type.
    -->
    <ProjectReference Include="..\..\paper09-example\domain\TetrisDomain.csproj" />

    <!--
      The actor facade is referenced only by the `play` verb, which drives the
      SAME TetrisActor.Persistent host the warm server uses, so staging 1's
      journal is produced by the real staging's code path rather than by a
      journal written by hand. `read` does not use it.
    -->
    <ProjectReference Include="..\..\paper09-example\actor\TetrisActor.csproj" />

    <!--
      THE ONE EXTERNAL SEAM, as in the example's own actor project. The two
      references below read ..\..\..\Puppeteer Pacifico\ until this project was
      vendored here, which pointed at a working copy on one machine and at
      nothing anywhere else. Point PuppeteerEngine at a Puppeteer checkout at or
      after commit 2673d57 instead:

          $env:PuppeteerEngine = "C:\path\to\Puppeteer"
    -->
    <ProjectReference Include="$(PuppeteerEngine)\Puppeteer\Puppeteer.csproj" />
    <ProjectReference Include="$(PuppeteerEngine)\Choreography\Choreography.csproj" />
  </ItemGroup>

  <Target Name="RequirePuppeteerEngine" BeforeTargets="CollectPackageReferences;ResolveProjectReferences">
    <Error Condition="'$(PuppeteerEngine)' == ''"
           Text="PuppeteerEngine is not set. This lab needs a Puppeteer checkout at or after commit 2673d57. Set $env:PuppeteerEngine, or pass -p:PuppeteerEngine=&lt;path&gt;. See labs/paper09-README.md." />
    <Error Condition="'$(PuppeteerEngine)' != '' And !Exists('$(PuppeteerEngine)\Puppeteer\Puppeteer.csproj')"
           Text="PuppeteerEngine=$(PuppeteerEngine) does not contain Puppeteer\Puppeteer.csproj. Point it at the root of a Puppeteer checkout." />
  </Target>

</Project>
