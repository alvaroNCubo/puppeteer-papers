<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tetris.WebRest</RootNamespace>
    <AssemblyName>TetrisWebRest</AssemblyName>
    <!-- The VS threading analyzer (from the engine's package graph) over-flags
         idiomatic ASP.NET await/sync patterns in this host shell. Quiet them here;
         the host is correct. -->
    <NoWarn>$(NoWarn);VSTHRD002;VSTHRD003;VSTHRD200</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same TetrisActor + OutputTarget seam as the WebSocket lab; only the shell
         (and its push mechanism, SSE) differs. The clean Well is untouched. -->
    <ProjectReference Include="..\actor\TetrisActor.csproj" />
  </ItemGroup>

</Project>
