<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tetris.Observing</RootNamespace>
    <AssemblyName>TetrisObserver</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The observer reads the TetrisActor's snapshot only — it never commands. -->
    <ProjectReference Include="..\actor\TetrisActor.csproj" />
  </ItemGroup>

</Project>
