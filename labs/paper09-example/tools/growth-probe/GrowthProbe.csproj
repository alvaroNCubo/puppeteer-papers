<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tetris.Tools</RootNamespace>
    <AssemblyName>TetrisGrowthProbe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Measurement apparatus for the domain-growth experiment (see
      Tetris/notes/domain-growth-score-and-difficulty.md). It is NOT a staging:
      it exists to record a journal with one build of the domain and to replay
      that journal with another, so the replay question can be answered by
      running it rather than by argument. Deliberately kept out of Tetris.sln so
      it never enters the staging counts.
    -->
    <ProjectReference Include="..\..\actor\TetrisActor.csproj" />
  </ItemGroup>

</Project>
