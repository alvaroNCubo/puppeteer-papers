<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tetris.Sending</RootNamespace>
    <AssemblyName>TetrisSend</AssemblyName>
  </PropertyGroup>

  <!-- Deliberately NO reference to the actor/domain/engine: the sender carries a
       verb over a named pipe and nothing else. That is what keeps it fast — no
       game logic, no rehydration. -->

</Project>
