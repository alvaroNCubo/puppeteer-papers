<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tetris.Console</RootNamespace>
    <AssemblyName>TetrisConsole</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The console drives the TetrisActor only — no direct Well, no DSL. The
         actor transitively brings the domain and the engine. -->
    <ProjectReference Include="..\actor\TetrisActor.csproj" />
  </ItemGroup>

</Project>
