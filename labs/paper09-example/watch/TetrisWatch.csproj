<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tetris.Watching</RootNamespace>
    <AssemblyName>TetrisWatch</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The viewer renders the PUSHED frame (parsed + drawn). It references the
         actor project only for the frame parse + the shared renderer; it never
         opens the journal or issues a command. -->
    <ProjectReference Include="..\actor\TetrisActor.csproj" />
  </ItemGroup>

</Project>
